local x = mako or xedge
assert(x,"This app requires Mako or Xedge")
x.createloader(io)
local conf=mako and require"loadconf" or {}

local rw=require"rwfile"
local GITHUB_TOKEN,MCP_AUTH_TOKEN,info,settingsMarker
local GITHUB_API=conf.LSP_CLAW_GITHUB_API
local settingsIo=ba.openio(mako and "home" or "disk")

local function validateMcpToken(token)
   if type(token) ~= "string" then return nil,"MCP token must be a string" end
   if #token < 16 then return nil,"MCP token must contain at least 16 bytes" end
   if #token > 4096 then return nil,"MCP token must not exceed 4096 bytes" end
   if token:find("[%z\r\n]") then return nil,"MCP token contains invalid characters" end
   return token
end

app.validateMcpToken=validateMcpToken

local function missingFile(err)
   return err == "notfound" or err == "enoent"
end

-- Settings belong to writable host storage, never the application ZIP.
local function readSettings(name)
   local fp,err=settingsIo:open(name,"rb")
   if not fp and missingFile(err) then
      -- Recover the old record if power was lost between the two renames.
      local restored,restoreErr=settingsIo:rename(name..".bak",name)
      if not restored and missingFile(restoreErr) then return nil end
      assert(restored,"Cannot recover "..name..": "..tostring(restoreErr))
      fp,err=settingsIo:open(name,"rb")
   end
   assert(fp,"Cannot read "..name..": "..tostring(err))
   local data,readErr=fp:read(65537)
   local ok,closeErr=fp:close()
   assert(data and not readErr and ok and #data <= 65536,
          "Cannot read "..name..": "..tostring(readErr or closeErr or "invalid size"))
   return data
end

local function writeSettings(name,data)
   if #data > 65536 then return nil,"settings exceed 64 KiB limit" end
   -- A previous failed rollback must be recovered before replacing its backup.
   local recovered,recoverErr=settingsIo:rename(name..".bak",name)
   if not recovered and not missingFile(recoverErr) and recoverErr ~= "exist" then return nil,recoverErr end
   local tmp=name..".tmp"
   local fp,err=settingsIo:open(tmp,"wb")
   if not fp then return nil,err end
   local ok
   ok,err=fp:write(data)
   local closed,closeErr=fp:close()
   if ok and closed then
      local backup=name..".bak"
      local removed,removeErr=settingsIo:remove(backup)
      if not removed and not missingFile(removeErr) then settingsIo:remove(tmp) return nil,removeErr end
      local moved,moveErr=settingsIo:rename(name,backup)
      if not moved and not missingFile(moveErr) then settingsIo:remove(tmp) return nil,moveErr end
      ok,err=settingsIo:rename(tmp,name)
      if ok then settingsIo:remove(backup)
      elseif moved then settingsIo:rename(backup,name) end
   else ok,err=nil,err or closeErr end
   if not ok then settingsIo:remove(tmp) end
   return ok,err
end

local function decodeSettings(data)
   local value,extra=ba.json.decode(data)
   assert(type(value) == "table" and extra == nil,"Invalid LSP-Claw settings record")
   return value
end

local tokenKey=ba.crypto.hash"sha256"(ba.tpm.uniquekey("LSP-Claw-Keys",32))(true)
local function storeTokens(githubToken,authToken)
   if githubToken ~= nil and type(githubToken) ~= "string" then return nil,"GitHub token must be a string" end
   if authToken == "" then authToken=nil end
   if authToken then
      local valid,err=validateMcpToken(authToken)
      if not valid then return nil,err end
   end
   local iv=ba.rndbs(12)
   local cipher,tag=ba.crypto.symmetric("GCM",tokenKey,iv):encrypt(
      assert(ba.json.encode{githubToken=githubToken,authToken=authToken}))
   local ok,err=writeSettings("LSP-Claw-Keys.bin","LCK2"..iv..tag..cipher)
   if not ok then return nil,err or "cannot save token settings" end
   GITHUB_TOKEN,MCP_AUTH_TOKEN=githubToken,authToken
   settingsMarker=authToken and ba.crypto.hash"sha256"(authToken)(true)
   if info then info.setToken(githubToken) end
   return true
end

function app.getTokens()
   return GITHUB_TOKEN,MCP_AUTH_TOKEN
end
app.saveTokens=storeTokens

local tokenData=readSettings("LSP-Claw-Keys.bin")
if tokenData then
   local modern=tokenData:sub(1,4) == "LCK2"
   local iv=modern and tokenData:sub(5,16) or "0123456789AB"
   local offset=modern and 17 or 1
   local plain=ba.crypto.symmetric("GCM",tokenKey,iv):decrypt(
      tokenData:sub(offset+16),tokenData:sub(offset,offset+15))
   assert(plain,"Cannot decrypt LSP-Claw token settings")
   local tokens=decodeSettings(plain)
   GITHUB_TOKEN,MCP_AUTH_TOKEN=tokens.githubToken,tokens.authToken
   assert(GITHUB_TOKEN == nil or type(GITHUB_TOKEN) == "string","Invalid stored GitHub token")
   if MCP_AUTH_TOKEN then assert(validateMcpToken(MCP_AUTH_TOKEN)) end
   -- Preserve existing records; the next save migrates the legacy encryption.
   settingsMarker=MCP_AUTH_TOKEN and ba.crypto.hash"sha256"(MCP_AUTH_TOKEN)(true)
else
   GITHUB_TOKEN,MCP_AUTH_TOKEN=conf.GITHUB_TOKEN,conf.MCP_AUTH_TOKEN
   if GITHUB_TOKEN or MCP_AUTH_TOKEN then assert(storeTokens(GITHUB_TOKEN,MCP_AUTH_TOKEN)) end
end

local function initializeCommandLineToken()
   for ix,arg in ipairs(mako and mako.argv or {}) do
      if arg == "-token" then
         if MCP_AUTH_TOKEN then
            trace("LSP-Claw command-line token ignored: an MCP token already exists")
            return
         end
         local token=mako.argv[ix+1]
         if type(token) ~= "string" or token == "" or token:sub(1,1) == "-" then
            error("LSP-Claw command-line option -token requires a value",2)
         end
         local valid,err=validateMcpToken(token)
         if not valid then error(err,2) end
         local ok
         ok,err=storeTokens(GITHUB_TOKEN,valid)
         if not ok then error("LSP-Claw MCP token setup failed: "..tostring(err),2) end
         trace("LSP-Claw command-line token enabled MCP authentication")
         return
      end
   end
end

local tokenOptionOk,tokenOptionErr=pcall(initializeCommandLineToken)
if not tokenOptionOk then
   trace("LSP-Claw command-line token failed: "..tostring(tokenOptionErr))
   error(tokenOptionErr,0)
end

local SETTINGS_SESSION_KEY="lspClawSettingsToken"
function app.settingsSession(cmd,authenticate)
   local session=authenticate == true and cmd:session(true) or cmd:session()
   if session and authenticate ~= nil then
      session[SETTINGS_SESSION_KEY]=authenticate and settingsMarker or nil
   end
   local marker=settingsMarker
   return marker ~= nil and session and session[SETTINGS_SESSION_KEY] == marker or false
end

if GITHUB_TOKEN then
   tracep(5, "Using GitHub token for authenticated API requests")
else
   tracep(0, "WARNING: no GitHub token. You have limited GitHub access")
end
if MCP_AUTH_TOKEN then
   tracep(5, "MCP bearer token authentication enabled")
else
   tracep(0, "WARNING: MCP bearer token authentication is disabled")
end

local ghio
ghio,info = require"GitHubIo".create{
   owner  = "RealTimeLogic",
   repo	  = "LSP-Examples",
   branch = "master",
   api=GITHUB_API,
   token=GITHUB_TOKEN,
   publicArchiveFallback=true,
   archiveCacheIo=ba.openio(mako and "home" or "disk"),
   archiveCachePath="LSP-Claw-GitHub-ReadCache.zip",
   log=function(url,code,message) trace(url,code,message,debug.traceback()) end,
   mtime=os.time()
}

function app.validateGitHubToken(token)
   return info.validateToken(token)
end

local transferFields={
   {"transferTtl","LSP_CLAW_TRANSFER_TTL_SECONDS","Ticket lifetime (seconds)"},
   {"transferReadTimeoutMs","LSP_CLAW_TRANSFER_READ_TIMEOUT_MS","Transfer I/O timeout (milliseconds)"},
   {"transferTotalTimeoutSeconds","LSP_CLAW_TRANSFER_TOTAL_TIMEOUT_SECONDS","Download time limit (seconds)"}
}
local function transferOptions(values)
   local options={}
   for _,field in ipairs(transferFields) do
      local value=values[field[1]]
      if value == nil then value=conf[field[2]] end
      if value ~= nil then
         value=tonumber(value)
         if not value or value <= 0 or value%1 ~= 0 or value > 2147483647 then
            return nil,field[3].." must be a positive integer up to 2147483647"
         end
         options[field[1]]=value
      end
   end
   return options
end
local transferData=readSettings("LSP-Claw-Settings.json")
local transferSettings=transferData and decodeSettings(transferData) or {}
local appmgr=require"appmgr"
local archiveManager=require"lab_archive".create(appmgr,assert(transferOptions(transferSettings)))
app.transferFields=transferFields
function app.getTransferSettings()
   return transferSettings,archiveManager
end
function app.saveTransferSettings(values)
   local options,err=transferOptions(values)
   if not options then return nil,err end
   local ok
   ok,err=writeSettings("LSP-Claw-Settings.json",assert(ba.json.encode(values)))
   if ok then transferSettings=values end
   return ok,err
end

local mcp = require"fastmcp.engine".create {
   name = "BAS Example Workspace Assistant",
   version = "0.2.0",
   instructions = rw.file(io,".info/instructions.md")
}

local traceDir = ba.create.tracelogger()
if "function" ~= type(traceDir.ontrace) then error"Error: server too old; Upgrade your server!" end
local transport
local traceStreamCount = 0
local traceHookActive = false
local runtimeTraceBufferSize = 10 * 1024
local runtimeTrace = {}

local function traceMessage(msg)
   local data = tostring(msg):gsub("\r\n", "\n"):gsub("\r", "\n")
   if transport then
      transport:notifyAll("notifications/message", {
	 level = "info",
	 logger = "trace",
	 data = data
      })
   end
   if runtimeTrace.record then runtimeTrace.record(data) end
end

local function updateTraceHook()
   local shouldTrace = traceStreamCount > 0 or runtimeTraceBufferSize > 0
   if shouldTrace and not traceHookActive then
      traceDir:ontrace(traceMessage)
      traceHookActive = true
   elseif not shouldTrace and traceHookActive then
      traceDir:ontrace()
      traceHookActive = false
   end
end

local function attachTraceStream()
   traceStreamCount = traceStreamCount + 1
   updateTraceHook()
end

local function detachTraceStream()
   if traceStreamCount > 0 then traceStreamCount = traceStreamCount - 1 end
   updateTraceHook()
end

local function authorizeLocalOrigin(origin, cmd, ctx)
   if origin == nil then return true end
   if string.match(origin, "^https?://localhost:%d+$") then return true end
   if string.match(origin, "^https?://127%.0%.0%.1:%d+$") then return true end
   if string.match(origin, "^https?://%[::1%]:%d+$") then return true end
   return false, "Origin forbidden"
end

local function authorizeBearerToken(cmd)
   if not MCP_AUTH_TOKEN then return true end
   if cmd:header"Authorization" == "Bearer " .. MCP_AUTH_TOKEN then return true end
   return false, "Unauthorized"
end

local function authorizeRequest(origin, cmd, ctx)
   local ok, reason = authorizeLocalOrigin(origin, cmd, ctx)
   if not ok then return false, reason end
   if cmd:method() == "OPTIONS" then return true end
   return authorizeBearerToken(cmd)
end

local function tokenConfigured(token)
   return token ~= nil and token ~= ""
end

local function getConfigurationStatus()
   local baseUri = ""
   if dir and type(dir.baseuri) == "function" then
      baseUri = dir:baseuri() or ""
   end
   return {
      githubTokenSet = tokenConfigured(GITHUB_TOKEN),
      mcpAuthTokenSet = tokenConfigured(MCP_AUTH_TOKEN),
      setupBaseUri = baseUri
   }
end

require"lspclaw".register(mcp, ghio, appmgr, {
   instructions = mcp.instructions,
   io = io,
   runtimeTrace = runtimeTrace,
   runtimeTraceBufferSize = runtimeTraceBufferSize,
   configurationStatus = getConfigurationStatus,
   archiveManager = archiveManager
})

local function authorizeArchiveRequest(cmd)
   if not MCP_AUTH_TOKEN then return true end
   if app.settingsSession(cmd) then return true end
   return cmd:header"Authorization" == "Bearer "..MCP_AUTH_TOKEN
end

local function authorizeBrowserRequest(cmd)
   return not MCP_AUTH_TOKEN or app.settingsSession(cmd)
end

local function archivePath(ticket)
   local base=(dir and dir:baseuri()) or "/"
   if base == "" then base="/" end
   if base:sub(-1) ~= "/" then base=base.."/" end
   return base.."archive.lsp?ticket="..ticket
end

local function sendJson(response,status,value)
   local encoded=ba.json.encode(value)
   response:setstatus(status)
   response:setcontenttype("application/json; charset=utf-8")
   response:setheader("Cache-Control","no-store")
   response:setheader("Content-Length",tostring(#encoded))
   response:send(encoded)
end

function app.listLabs()
   return appmgr.listLabs()
end

function app.prepareBrowserLabExport(labName)
   local lab,err,code=appmgr.getLab(labName)
   if not lab then return nil,err,code end
   local prepared
   prepared,err,code=archiveManager:prepareExport(lab)
   if not prepared then return nil,err,code end
   prepared.downloadPath=archivePath(prepared.ticket)
   prepared.ticket=nil
   return prepared
end

function app.setBrowserLabRunning(labName,running)
   local lab,err,code=appmgr.getLab(labName)
   if not lab then return nil,err,code end
   if running == lab:isRunning() then
      return {labName=lab:name(),running=running,changed=false}
   end
   local ok
   if running then
      ok,err=lab:start()
      code="labStartFailed"
   else
      ok,err=lab:stop()
      code="labStopFailed"
   end
   if not ok then return nil,err,code end
   return {labName=lab:name(),running=lab:isRunning(),changed=true}
end

function app.labApiService(cmd,response)
   if not authorizeBrowserRequest(cmd) then sendJson(response,401,{ok=false,error="Unauthorized"}) return end
   if cmd:method() ~= "POST" then sendJson(response,405,{ok=false,error="Method not allowed"}) return end
   if cmd:data("action") == "setRunning" then
      local value=cmd:data("running")
      if value ~= "true" and value ~= "false" then
         sendJson(response,400,{ok=false,error="The running field must be true or false",code="invalidRunningState"})
         return
      end
      local result,err,code=app.setBrowserLabRunning(cmd:data("labName"),value == "true")
      if not result then sendJson(response,409,{ok=false,error=err,code=code}) return end
      sendJson(response,200,{ok=true,result=result})
      return
   end
   if cmd:data("action") == "prepareExport" then
      local prepared,err,code=app.prepareBrowserLabExport(cmd:data("labName"))
      if not prepared then sendJson(response,409,{ok=false,error=err,code=code}) return end
      sendJson(response,200,{ok=true,result=prepared})
      return
   end
   if cmd:data("action") ~= "prepareImport" then sendJson(response,400,{ok=false,error="Unknown action"}) return end
   local prepared,err,code=archiveManager:prepareImport(cmd:data("labName"),cmd:data("conflictAction"),cmd:data("confirmed") == "true")
   if not prepared then sendJson(response,409,{ok=false,error=err,code=code}) return end
   prepared.uploadPath=archivePath(prepared.ticket)
   prepared.ticket=nil
   sendJson(response,200,{ok=true,result=prepared})
end

function app.archiveService(cmd,response)
   return archiveManager:handle(cmd,response,authorizeArchiveRequest(cmd))
end

function app.transferService(cmd,response)
   return archiveManager:handleTransfer(cmd,response)
end

function app.setRuntimeTraceBufferSize(size)
   runtimeTraceBufferSize = runtimeTrace.setBufferSize(size)
   updateTraceHook()
   return runtimeTraceBufferSize
end

local Http = require"fastmcp.http"
transport = Http.streamable(mcp, {
   requireStrictAccept = false,
   allowNonSseGet = true,
   authorizeOrigin = authorizeRequest,
   onStreamOpen = function(session, stream, self)
      attachTraceStream()
   end,
   onStreamClose = function(session, stream, self)
      detachTraceStream()
   end
})
updateTraceHook()

function app.cmdService(cmd)
   return transport:handle(cmd)
end

function onunload()
   if transport then
      for id in pairs(transport.sessions) do transport:closeSession(id) end
   end
   for _,ticket in pairs(archiveManager.tickets) do
      if ticket.path then archiveManager.baseIo:remove(ticket.path) end
   end
   traceDir:ontrace()
end
